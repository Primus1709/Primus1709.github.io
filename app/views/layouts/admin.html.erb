<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex">
    <title><%= content_for?(:title) ? "#{yield(:title)} | Admin" : "Admin" %></title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= render "shared/head_assets" %>
  </head>

  <body class="admin">
    <header class="site-header">
      <div class="wrap site-header__inner">
        <%= link_to "Admin", admin_root_path, class: "site-header__name" %>
        <nav aria-label="Admin">
          <ul class="site-nav">
            <li><%= nav_link_to "Projects", admin_projects_path %></li>
            <li>
              <%= link_to admin_messages_path, "aria-current": (current_page?(admin_messages_path) ? "page" : nil) do %>
                Messages<% if @unread_count.to_i.positive? %> <span class="badge"><%= @unread_count %><span class="visually-hidden"> unread</span></span><% end %>
              <% end %>
            </li>
            <li><%= link_to "View site", root_path %></li>
            <li><%= render "shared/theme_toggle" %></li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main" class="wrap admin__main">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>
  </body>
</html>
