<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title><%= content_for?(:title) ? "#{yield(:title)} | #{profile[:name]}" : "#{profile[:name]} | #{profile[:role]}" %></title>
    <meta name="description" content="<%= profile[:tagline] %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= render "shared/head_assets" %>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="wrap site-header__inner">
        <%= link_to profile[:name], root_path, class: "site-header__name" %>
        <nav aria-label="Main">
          <ul class="site-nav">
            <li><%= nav_link_to "Work", projects_path %></li>
            <li><%= link_to "About", root_path(anchor: "about") %></li>
            <li><%= link_to "Contact", root_path(anchor: "contact") %></li>
            <li><%= render "shared/theme_toggle" %></li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <% unless content_for?(:inline_flash) %>
        <div class="wrap"><%= render "shared/flash" %></div>
      <% end %>
      <%= yield %>
    </main>

    <footer class="site-footer">
      <div class="wrap site-footer__inner">
        <p>&copy; <%= Date.current.year %> <%= profile[:name] %>. Built with Ruby on Rails.</p>
        <ul class="plain-list inline-list">
          <% profile[:links].each do |link| %>
            <li><%= link_to link[:label], link[:url] %></li>
          <% end %>
          <li><%= mail_link %></li>
        </ul>
      </div>
    </footer>
  </body>
</html>
