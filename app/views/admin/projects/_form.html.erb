<%= form_with model: [:admin, project], class: "form admin-form" do |form| %>
  <%= render "shared/errors", record: project %>

  <fieldset>
    <legend>Basics</legend>

    <div class="field">
      <%= form.label :title %>
      <%= form.text_field :title, required: true, maxlength: 120 %>
    </div>

    <div class="field">
      <%= form.label :summary, "One-sentence summary" %>
      <%= form.text_field :summary, required: true, maxlength: 280 %>
      <p class="hint">Shown in project lists. Say what it does and who it's for.</p>
    </div>

    <div class="form__row form__row--split">
      <div class="field">
        <%= form.label :role, "Your role" %>
        <%= form.text_field :role, placeholder: "Solo project, or Team of 4, backend" %>
      </div>
      <div class="field">
        <%= form.label :year %>
        <%= form.number_field :year, min: 1991, max: Date.current.year + 1 %>
      </div>
    </div>

    <div class="field">
      <%= form.label :tech_stack, "Built with" %>
      <%= form.text_field :tech_stack, placeholder: "Java, Spring Boot, PostgreSQL" %>
      <p class="hint">Separate with commas.</p>
    </div>
  </fieldset>

  <fieldset>
    <legend>Case study</legend>
    <p class="hint">Leave a blank line between paragraphs.</p>

    <div class="field">
      <%= form.label :problem, "The problem" %>
      <%= form.text_area :problem, rows: 4 %>
    </div>
    <div class="field">
      <%= form.label :approach, "How I built it" %>
      <%= form.text_area :approach, rows: 8 %>
    </div>
    <div class="field">
      <%= form.label :outcome, "What came of it" %>
      <%= form.text_area :outcome, rows: 4 %>
    </div>
  </fieldset>

  <fieldset>
    <legend>Links</legend>
    <div class="form__row form__row--split">
      <div class="field">
        <%= form.label :live_url, "Live site" %>
        <%= form.url_field :live_url, placeholder: "https://" %>
      </div>
      <div class="field">
        <%= form.label :repo_url, "Source code" %>
        <%= form.url_field :repo_url, placeholder: "https://github.com/…" %>
      </div>
    </div>
  </fieldset>

  <fieldset>
    <legend>Display</legend>
    <div class="form__row form__row--split">
      <div class="field">
        <%= form.label :slug, "Web address" %>
        <%= form.text_field :slug, placeholder: "Made from the title if left blank" %>
        <p class="hint">The project's page will be at /projects/<em>web-address</em>.</p>
      </div>
      <div class="field">
        <%= form.label :position, "Order" %>
        <%= form.number_field :position %>
        <p class="hint">Lower numbers show first.</p>
      </div>
    </div>

    <div class="check">
      <%= form.check_box :featured %>
      <%= form.label :featured, "Show on the home page" %>
    </div>
    <div class="check">
      <%= form.check_box :published %>
      <%= form.label :published, "Published (untick to hide it while you work on it)" %>
    </div>
  </fieldset>

  <div class="form__actions">
    <%= form.submit project.persisted? ? "Save changes" : "Add project", class: "button" %>
    <%= link_to "Cancel", admin_projects_path, class: "button button--quiet" %>
  </div>
<% end %>
