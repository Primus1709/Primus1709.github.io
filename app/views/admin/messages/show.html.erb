<% page_title "Message from #{@message.name}" %>

<p class="case-study__back"><%= link_to "All messages", admin_messages_path %></p>

<article class="message">
  <header class="message__header">
    <h1><%= @message.name %></h1>
    <p><%= mail_to @message.email %></p>
    <p class="hint">Sent <time datetime="<%= @message.created_at.iso8601 %>"><%= l(@message.created_at, format: :long) %></time></p>
  </header>

  <div class="prose message__body"><%= simple_format(@message.body) %></div>

  <div class="form__actions">
    <%= mail_to @message.email, "Reply by email", subject: "Re: your message", class: "button" %>
    <%= button_to "Delete message", admin_message_path(@message), method: :delete,
          class: "button button--danger",
          form: { data: { confirm: "Delete this message? This can't be undone." } } %>
  </div>
</article>
