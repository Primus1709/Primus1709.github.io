<% page_title @project.title %>

<article class="case-study wrap">
  <p class="case-study__back"><%= link_to "All work", projects_path %></p>

  <header class="case-study__header">
    <h1 class="case-study__title"><%= @project.title %></h1>
    <p class="case-study__summary"><%= @project.summary %></p>

    <dl class="facts">
      <% if @project.year.present? %>
        <div><dt>Year</dt><dd><%= @project.year %></dd></div>
      <% end %>
      <% if @project.role.present? %>
        <div><dt>Role</dt><dd><%= @project.role %></dd></div>
      <% end %>
      <% if @project.tech_list.any? %>
        <div><dt>Built with</dt><dd><%= @project.tech_list.to_sentence %></dd></div>
      <% end %>
    </dl>

    <% if @project.repo_url.present? || @project.live_url.present? %>
      <div class="case-study__actions">
        <% if @project.live_url.present? %>
          <%= external_link_to "Open the live site", @project.live_url, class: "button" %>
        <% end %>
        <% if @project.repo_url.present? %>
          <%= external_link_to "Read the source code", @project.repo_url, class: "button button--quiet" %>
        <% end %>
      </div>
    <% end %>
  </header>

  <% if @project.case_study? %>
    <div class="case-study__body">
      <% { "The problem" => @project.problem, "How I built it" => @project.approach, "What came of it" => @project.outcome }.each do |heading, text| %>
        <% next if text.blank? %>
        <section class="case-study__part">
          <h2><%= heading %></h2>
          <div class="prose"><%= simple_format(text) %></div>
        </section>
      <% end %>
    </div>
  <% end %>

  <nav class="pager" aria-label="More projects">
    <% if @previous_project %>
      <%= link_to project_path(@previous_project), class: "pager__link pager__link--prev" do %>
        <span class="pager__hint">Previous</span>
        <span class="pager__title"><%= @previous_project.title %></span>
      <% end %>
    <% end %>
    <% if @next_project %>
      <%= link_to project_path(@next_project), class: "pager__link pager__link--next" do %>
        <span class="pager__hint">Next</span>
        <span class="pager__title"><%= @next_project.title %></span>
      <% end %>
    <% end %>
  </nav>
</article>
