<%= form_with model: message, url: messages_path, class: "form contact-form" do |form| %>
  <%= render "shared/errors", record: message %>

  <div class="form__row form__row--split">
    <div class="field">
      <%= form.label :name, "Your name" %>
      <%= form.text_field :name, required: true, maxlength: 100, autocomplete: "name" %>
    </div>
    <div class="field">
      <%= form.label :email, "Your email" %>
      <%= form.email_field :email, required: true, maxlength: 254, autocomplete: "email" %>
    </div>
  </div>

  <div class="field">
    <%= form.label :body, "Message" %>
    <%= form.text_area :body, required: true, rows: 6, minlength: 10, maxlength: 5000 %>
  </div>

  <%# Hidden from people. Bots fill it in, which is how we spot them. %>
  <div class="honeypot" aria-hidden="true">
    <label for="message_website">Leave this empty</label>
    <input type="text" name="message[website]" id="message_website" tabindex="-1" autocomplete="off">
  </div>

  <%= form.submit "Send message", class: "button" %>
<% end %>
