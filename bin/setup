#!/usr/bin/env ruby
require "fileutils"

APP_ROOT = File.expand_path("..", __dir__)

def system!(*args)
  system(*args, exception: true)
end

FileUtils.chdir APP_ROOT do
  puts "== Installing gems =="
  system("bundle check") || system!("bundle install")

  puts "\n== Creating the database and loading sample projects =="
  system! "ruby bin/rails db:prepare"
  system! "ruby bin/rails db:seed"

  puts "\n== Clearing old logs and temp files =="
  system! "ruby bin/rails log:clear tmp:clear"

  unless ARGV.include?("--skip-server")
    puts "\n== Starting the server at http://localhost:3000 =="
    exec "ruby bin/rails server"
  end
end
